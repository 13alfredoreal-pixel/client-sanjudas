{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "destination": "https://server-san-judas-tau.vercel.app/api/:splat"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
